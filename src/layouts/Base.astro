---
import { Font } from "astro:assets";
import "../styles/global.css";
import { site, socials } from "../data/site";
import { skills } from "../data/skills";

interface Props {
  title?: string;
  description?: string;
  /** Path for canonical/og:url, e.g. "/". */
  path?: string;
  noindex?: boolean;
}

const { title = site.title, description = site.description, path = "/", noindex = false } = Astro.props;
const canonical = new URL(path, site.url).href;
const ogImage = new URL(site.ogImage, site.url).href;
const sameAs = socials.map((s) => s.href);

const person = {
  "@type": "Person",
  "@id": `${site.url}/#person`,
  name: site.name,
  alternateName: site.alternateNames,
  jobTitle: site.jobTitle,
  url: `${site.url}/`,
  image: ogImage,
  email: `mailto:${site.email}`,
  description: site.description,
  knowsAbout: skills.flatMap((g) => g.items).slice(0, 40),
  sameAs,
};

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    person,
    {
      "@type": "WebSite",
      "@id": `${site.url}/#website`,
      name: site.title,
      url: `${site.url}/`,
      inLanguage: "en-US",
      author: { "@id": `${site.url}/#person` },
    },
    {
      "@type": "ProfilePage",
      "@id": `${site.url}/#profile`,
      url: `${site.url}/`,
      name: site.title,
      mainEntity: { "@id": `${site.url}/#person` },
      isPartOf: { "@id": `${site.url}/#website` },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta
      name="robots"
      content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
    />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="text/markdown" href="/llms.txt" title="LLM-friendly version" />
    <link rel="icon" href="/nihesh.png" type="image/png" />
    <link rel="apple-touch-icon" href="/nihesh.png" />
    <meta name="theme-color" content="#ebedec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1d2023" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Nihesh Rachakonda Portfolio" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta property="og:image:alt" content={site.ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={site.twitter} />
    <meta name="twitter:creator" content={site.twitter} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={site.ogImageAlt} />

    <script is:inline>
      // Set theme before first paint so there is no flash of the wrong one.
      (function () {
        var d = document.documentElement;
        var t = null;
        try { t = localStorage.getItem("theme"); } catch (e) {}
        if (t !== "light" && t !== "dark") {
          t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        d.dataset.theme = t;
        d.classList.add("js");
        if (!matchMedia("(prefers-reduced-motion: reduce)").matches) d.classList.add("anim-intro");
      })();
    </script>

    <Font cssVariable="--font-newsreader" preload={[{ style: "normal" }]} />

    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a href="#main" class="sr-only-focusable fixed left-3 top-3 z-50 bg-paper px-3 py-2">Skip to content</a>
    <slot />
    <script>
      import "../scripts/site";
    </script>
  </body>
</html>
