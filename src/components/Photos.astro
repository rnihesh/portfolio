---
import { Picture, getImage } from "astro:assets";
import Icon from "./Icon.astro";
import { photos, photosUrl } from "../data/photos";

// Larger versions for the lightbox, built at build time.
const items = await Promise.all(
  photos.map(async (p) => {
    const src = p.full ?? p.image;
    const large = await getImage({ src, width: Math.min(src.width, 2000), format: "webp", quality: 82 });
    return { ...p, large };
  }),
);
---

<section id="photos" class="section wrap" aria-labelledby="photos-title">
  <div class="head">
    <h2 id="photos-title" class="section-title">Through my lens</h2>
    <a href={photosUrl} target="_blank" rel="noopener">More on VSCO</a>
  </div>

  <ul class="grid reveal" role="list">
    {
      items.map((p, i) => (
        <li>
          <a
            class="photo"
            href={p.large.src}
            data-frame={i + 1}
            data-w={p.large.attributes.width}
            data-h={p.large.attributes.height}
            aria-label={`Open photo: ${p.alt}`}
          >
            <Picture
              src={p.image}
              formats={["avif", "webp"]}
              widths={[200, 300, 420, 600]}
              sizes="(min-width: 74rem) 16rem, (min-width: 44rem) calc(25vw - 2rem), calc(50vw - 1.75rem)"
              alt={p.alt}
              loading="lazy"
              decoding="async"
              quality={70}
            />
          </a>
        </li>
      ))
    }
  </ul>
</section>

<dialog id="lightbox" class="lightbox" aria-label="Photo">
  <figure>
    <img alt="" decoding="async" />
    <figcaption>
      <span data-caption></span>
      <span class="count" data-count></span>
    </figcaption>
  </figure>
  <div class="lb-controls">
    <button type="button" data-prev aria-label="Previous photo"><Icon name="prev" size={22} /></button>
    <button type="button" data-next aria-label="Next photo"><Icon name="next" size={22} /></button>
    <button type="button" data-close aria-label="Close"><Icon name="close" size={22} /></button>
  </div>
</dialog>

<style>
  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    font-size: 1rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 44rem) {
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1rem;
    }
  }
  .photo {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 4px;
    background: var(--paper-2);
    cursor: zoom-in;
  }
  .photo :global(picture),
  .photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    transition: opacity 200ms var(--ease);
  }
  .photo:hover :global(img) {
    opacity: 0.9;
  }

  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: #e9ebe9;
  }
  .lightbox::backdrop {
    background: rgb(12 13 14 / 0.94);
  }
  .lightbox[open] {
    display: grid;
    place-items: center;
  }
  @media (prefers-reduced-motion: no-preference) {
    .lightbox[open] figure {
      animation: lb-in 220ms var(--ease);
    }
  }
  @keyframes lb-in {
    from {
      opacity: 0;
    }
  }
  .lightbox figure {
    margin: 0;
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    padding: 4rem 1rem 1.25rem;
  }
  .lightbox img {
    width: auto;
    height: auto;
    max-width: min(92vw, 1400px);
    max-height: calc(100dvh - 9rem);
    object-fit: contain;
  }
  .lightbox figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 1rem;
    font-size: 0.95rem;
    text-align: center;
    max-width: 40rem;
  }
  .count {
    color: #a6adb1;
  }
  .lb-controls {
    position: fixed;
    top: 0.75rem;
    right: 0.75rem;
    display: flex;
    gap: 0.25rem;
  }
  .lb-controls button {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.08);
    color: inherit;
    cursor: pointer;
  }
  .lb-controls button:hover {
    background: rgb(255 255 255 / 0.16);
  }
  .lb-controls :focus-visible {
    outline-color: #f0c03a;
  }
</style>
