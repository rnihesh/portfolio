---
import Icon from "./Icon.astro";
import { site, socials } from "../data/site";
---

<section id="contact" class="section wrap" aria-labelledby="contact-title">
  <div class="section-grid">
    <div>
      <h2 id="contact-title" class="section-title">Let's connect</h2>
      <p class="lede">{site.openToWork ? "Open to work. " : ""}Email is the quickest way to reach me.</p>
    </div>
    <div>
      <a class="email" href={site.emailHref}>
        <span>{site.email}</span>
        <svg class="email-line" viewBox="0 0 600 24" preserveAspectRatio="none" aria-hidden="true">
          <path class="pencil" pathLength="1" stroke-width="4" d="M4 14 C 110 6, 240 8, 330 12 S 500 18, 596 8" />
        </svg>
      </a>

      <ul class="socials" role="list">
        {
          socials.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener me">
                <Icon name={s.icon} size={18} />
                <span class="label">{s.label}</span>
                <span class="handle muted">{s.handle}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .email {
    position: relative;
    display: inline-block;
    max-width: 100%;
    font-size: clamp(1.5rem, 5.2vw, 3.4rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-weight: 360;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .email-line {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.3em;
    width: 100%;
    height: 0.4em;
    overflow: visible;
  }
  .email-line path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 700ms var(--ease);
  }
  .email:hover .email-line path,
  .email:focus-visible .email-line path {
    stroke-dashoffset: 0;
  }
  @media (hover: none) {
    .email-line path {
      stroke-dashoffset: 0;
    }
  }
  .socials {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
    gap: 0.25rem 2rem;
    margin: 2.75rem 0 0;
    padding: 0;
    list-style: none;
  }
  .socials a {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.55rem 0;
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
  }
  .socials a:hover .label {
    text-decoration: underline;
    text-decoration-color: var(--pencil);
    text-underline-offset: 0.2em;
  }
  .socials a:hover :global(svg) {
    color: var(--pencil);
  }
  .handle {
    margin-left: auto;
    font-size: 0.95rem;
  }
</style>
