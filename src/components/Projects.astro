---
import Icon from "./Icon.astro";
import { projects } from "../data/projects";
import { socials } from "../data/site";
const github = socials.find((s) => s.icon === "github")!.href;
---

<section id="projects" class="section wrap" aria-labelledby="projects-title">
  <h2 id="projects-title" class="section-title">Projects</h2>

  <ul class="list" role="list">
    {
      projects.map((p) => (
        <li class="reveal">
          <a class="row" href={p.live ?? p.github} target="_blank" rel="noopener">
            <h3>{p.title}</h3>
            <p class="desc">{p.description}</p>
            <svg class="out" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg>
          </a>
        </li>
      ))
    }
  </ul>

  <p class="more reveal">
    <a href={github} target="_blank" rel="noopener me">
      <Icon name="github" size={16} />
      More on GitHub
      <span aria-hidden="true" class="arrow">&rarr;</span>
    </a>
  </p>
</section>

<style>
  .more {
    margin: 3rem 0 0;
  }
  .more a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--mute);
    text-decoration-color: transparent;
    transition: color 0.15s ease;
  }
  .more a :global(svg) {
    translate: 0 -0.1em;
  }
  .more a:hover {
    color: var(--ink);
  }
  .more .arrow {
    transition: translate 0.2s ease;
  }
  .more a:hover .arrow {
    translate: 0.2rem 0;
  }
  .list {
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
    border-block: 1px solid var(--rule);
  }
  .row {
    display: grid;
    gap: 0.25rem 2rem;
    padding: 1.25rem 0;
    color: inherit;
    text-decoration: none;
  }
  li + li .row {
    border-top: 1px solid var(--rule);
  }
  .out {
    display: none;
    color: var(--mute);
    transition: color 0.15s ease, translate 0.2s ease;
  }
  @media (min-width: 44rem) {
    .row {
      grid-template-columns: 11rem minmax(0, 1fr) auto;
      align-items: baseline;
    }
    .out {
      display: block;
      align-self: center;
    }
  }
  .row:hover .out {
    color: var(--ink);
  }
  @media (prefers-reduced-motion: no-preference) {
    .row:hover .out {
      translate: 0.12rem -0.12rem;
    }
  }
  h3 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 500;
    line-height: 1.3;
  }
  .desc {
    margin: 0;
    color: var(--mute);
  }
</style>
