---
import { Picture, Image } from "astro:assets";
import Icon from "./Icon.astro";
import { projects } from "../data/projects";
import { socials } from "../data/site";
const github = socials.find((s) => s.icon === "github")!.href;
---

<section id="projects" class="section wrap" aria-labelledby="projects-title">
  <h2 id="projects-title" class="section-title">Projects</h2>

  <ul class="grid" role="list">
    {
      projects.map((p) => (
        <li class="project reveal">
          <a class="shot" href={p.live ?? p.github} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
            <Picture
              src={p.image}
              formats={["avif", "webp"]}
              widths={[360, 540, 720, 1080]}
              sizes="(min-width: 74rem) 33rem, (min-width: 44rem) calc(50vw - 4rem), calc(100vw - 2.5rem)"
              alt=""
              loading="lazy"
              decoding="async"
              quality={70}
            />
          </a>
          <h3>
            <Image src={p.logo} width={20} height={20} densities={[1, 2]} alt="" class="logo" loading="lazy" />
            {p.title}
          </h3>
          <p class="desc">{p.description}</p>
          <p class="stack">{p.stack.join(", ")}</p>
          <p class="links">
            {p.live && (
              <a href={p.live} target="_blank" rel="noopener">
                <Icon name="external" size={15} />
                Live<span class="sr-only"> site for {p.title}</span>
              </a>
            )}
            <a href={p.github} target="_blank" rel="noopener">
              <Icon name="github" size={15} />
              Source<span class="sr-only"> for {p.title}</span>
            </a>
          </p>
        </li>
      ))
    }
  </ul>

  <p class="more reveal">
    <a href={github} target="_blank" rel="noopener me">
      <Icon name="github" size={16} />
      More on GitHub
      <span aria-hidden="true" class="arrow">&rarr;</span>
    </a>
  </p>
</section>

<style>
  .more {
    margin: 3rem 0 0;
  }
  .more a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--mute);
    text-decoration-color: transparent;
    transition: color 0.15s ease;
  }
  .more a :global(svg) {
    translate: 0 -0.1em;
  }
  .more a:hover {
    color: var(--ink);
  }
  .more .arrow {
    transition: translate 0.2s ease;
  }
  .more a:hover .arrow {
    translate: 0.2rem 0;
  }
  .grid {
    display: grid;
    gap: 3rem 2.5rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 44rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .shot {
    display: block;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: 6px;
    background: var(--paper-2);
    box-shadow: inset 0 0 0 1px var(--rule);
  }
  .shot :global(picture),
  .shot :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: top center;
  }
  .shot :global(img) {
    transition: opacity 200ms var(--ease);
  }
  .project:hover .shot :global(img) {
    opacity: 0.92;
  }
  h3 {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 1rem 0 0;
    font-size: 1.35rem;
    font-weight: 450;
    line-height: 1.2;
  }
  h3 :global(.logo) {
    width: 22px;
    height: 22px;
    padding: 2px;
    border-radius: 5px;
    background: var(--chip);
    object-fit: contain;
    flex: none;
  }
  .desc {
    margin: 0.3rem 0 0;
  }
  .stack {
    margin: 0.3rem 0 0;
    color: var(--mute);
    font-size: 0.95rem;
    line-height: 1.45;
  }
  .links {
    display: flex;
    gap: 1.25rem;
    margin: 0.6rem 0 0;
    font-size: 0.98rem;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
</style>
