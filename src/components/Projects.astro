---
import { Picture, Image } from "astro:assets";
import Icon from "./Icon.astro";
import { projects } from "../data/projects";
---

<section id="projects" class="section wrap" aria-labelledby="projects-title">
  <div class="section-grid">
    <div>
      <h2 id="projects-title" class="section-title">Projects</h2>
      <p class="lede">Things I've built, from agent tooling to a Mac menu-bar app.</p>
    </div>

    <ol class="list" role="list">
      {
        projects.map((p, i) => (
          <li class="project reveal">
            <a
              class="mount"
              href={p.live ?? p.github}
              target="_blank"
              rel="noopener"
              tabindex="-1"
              aria-hidden="true"
            >
              <span class="window">
                <Picture
                  src={p.image}
                  formats={["avif", "webp"]}
                  widths={[320, 480, 720, 960]}
                  sizes="(min-width: 56rem) 15rem, (min-width: 40rem) 14rem, 72vw"
                  alt=""
                  loading="lazy"
                  decoding="async"
                  quality={70}
                />
              </span>
              <span class="label hand">{p.tagline}</span>
              <span class="num hand">{String(i + 1).padStart(2, "0")}</span>
            </a>

            <div class="body">
              <h3>
                <Image
                  src={p.logo}
                  width={22}
                  height={22}
                  densities={[1, 2]}
                  alt=""
                  class:list={["logo", p.invertLogoInDark && "invert-dark"]}
                  loading="lazy"
                />
                {p.title}
              </h3>
              <p class="summary">{p.summary}</p>
              <p class="stack">
                <span class="sr-only">Built with </span>
                {p.stack.join(", ")}
              </p>
              <p class="links">
                {p.live && (
                  <a href={p.live} target="_blank" rel="noopener">
                    <Icon name="external" size={16} />
                    Live site<span class="sr-only"> for {p.title}</span>
                  </a>
                )}
                <a href={p.github} target="_blank" rel="noopener">
                  <Icon name="github" size={16} />
                  Source<span class="sr-only"> for {p.title}</span>
                </a>
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
  }
  .project {
    display: grid;
    gap: 1.25rem 2.25rem;
    align-items: start;
  }
  @media (min-width: 40rem) {
    .project {
      grid-template-columns: 14rem minmax(0, 1fr);
    }
  }
  @media (min-width: 56rem) {
    .project {
      grid-template-columns: 15rem minmax(0, 1fr);
    }
  }

  /* 35mm slide mount */
  .mount {
    position: relative;
    display: block;
    width: min(72vw, 100%);
    max-width: 17rem;
    aspect-ratio: 1;
    border-radius: 7%;
    background: var(--mount);
    box-shadow:
      inset 0 0 0 1px var(--mount-edge),
      0 1px 0 var(--mount-edge);
    text-decoration: none;
    color: var(--mute);
    transform: rotate(var(--tilt, -0.6deg));
    transition: transform 400ms var(--ease);
  }
  .project:nth-child(even) .mount {
    --tilt: 0.8deg;
  }
  .project:nth-child(3n) .mount {
    --tilt: -1.4deg;
  }
  .project:hover .mount {
    transform: rotate(0deg) translateY(-3px);
  }
  .window {
    position: absolute;
    left: 11%;
    top: 16%;
    width: 78%;
    aspect-ratio: 3 / 2;
    clip-path: url(#slide-window);
    background: var(--film);
  }
  .window :global(picture),
  .window :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: top center;
  }
  .label {
    position: absolute;
    left: 11%;
    right: 11%;
    top: 74%;
    font-size: clamp(0.8rem, 3.2vw, 0.9rem);
    line-height: 1.2;
    transform: rotate(-1.5deg);
  }
  .num {
    position: absolute;
    left: 11%;
    top: 5.5%;
    font-size: 0.75rem;
    color: var(--mute);
    opacity: 0.8;
  }

  .body h3 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    font-size: clamp(1.45rem, 2.6vw, 1.8rem);
    font-weight: 420;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .body :global(.logo) {
    width: 22px;
    height: 22px;
    border-radius: 5px;
    object-fit: contain;
    flex: none;
  }
  :global([data-theme="dark"]) .body :global(.invert-dark) {
    filter: invert(1);
  }
  .summary {
    margin: 0.6rem 0 0;
    max-width: 36rem;
    text-wrap: pretty;
  }
  .stack {
    margin: 0.6rem 0 0;
    color: var(--mute);
    font-size: 0.98rem;
    font-style: italic;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    margin: 0.85rem 0 0;
    font-size: 1rem;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
