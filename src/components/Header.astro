<header class="topbar wrap">
  <a href="/" class="mark" aria-label="Nihesh Rachakonda, home">
    <svg width="22" height="34" aria-hidden="true"><use href="#nr-mark" /></svg>
  </a>
  <nav aria-label="Sections">
    <ul>
      {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
    </ul>
  </nav>
  <button type="button" class="theme-btn" data-theme-toggle aria-label="Dark theme" aria-pressed="false">
    <Icon name="moon" class="i-moon" />
    <Icon name="sun" class="i-sun" />
  </button>
</header>

<style>
  .topbar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-block: 1.5rem;
  }
  .mark {
    display: inline-flex;
    color: var(--ink);
    margin-right: auto;
    transition: transform 300ms var(--ease);
  }
  .mark:hover {
    transform: rotate(-6deg);
  }
  nav ul {
    display: flex;
    gap: clamp(0.9rem, 2.4vw, 1.75rem);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 1rem;
  }
  nav a {
    text-decoration-color: transparent;
  }
  nav a:hover {
    text-decoration-color: var(--pencil);
  }
  .theme-btn {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-right: -0.5rem;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--ink);
    cursor: pointer;
  }
  .theme-btn:hover {
    background: var(--paper-2);
  }
  .theme-btn :global(.i-sun) {
    display: none;
  }
  :global([data-theme="dark"]) .theme-btn :global(.i-sun) {
    display: block;
  }
  :global([data-theme="dark"]) .theme-btn :global(.i-moon) {
    display: none;
  }
  @media (max-width: 40rem) {
    nav li:nth-child(n + 4) {
      display: none;
    }
  }
</style>
