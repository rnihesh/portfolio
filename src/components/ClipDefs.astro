---
// Shared SVG clip paths, in objectBoundingBox units so they fit any box.
---

<svg width="0" height="0" class="absolute" aria-hidden="true" focusable="false">
  <defs>
    <!-- Film gate: almost square, with the slight wobble of a hand-trimmed print. -->
    <clipPath id="gate" clipPathUnits="objectBoundingBox">
      <path
        d="M0.012 0.004 L0.35 0.001 L0.66 0.006 L0.988 0.002 Q0.998 0.003 0.997 0.014 L0.999 0.38 L0.995 0.71 L0.998 0.986 Q0.997 0.997 0.986 0.996 L0.62 0.999 L0.31 0.994 L0.014 0.998 Q0.003 0.997 0.004 0.986 L0.001 0.62 L0.005 0.3 L0.002 0.014 Q0.003 0.004 0.012 0.004 Z"
      ></path>
    </clipPath>
    <!-- 35mm slide window: rounded corners, slightly taller radius on the long side. -->
    <clipPath id="slide-window" clipPathUnits="objectBoundingBox">
      <path
        d="M0.04 0 H0.96 Q1 0 1 0.06 V0.94 Q1 1 0.96 1 H0.04 Q0 1 0 0.94 V0.06 Q0 0 0.04 0 Z"
      ></path>
    </clipPath>
  </defs>
</svg>
