---
import Icon from "./Icon.astro";
import { site } from "../data/site";
import { signaturePath } from "../data/signature";
---

<div class="hero-stage">
<section class="hero wrap" aria-labelledby="hero-name">
  <h1 id="hero-name" class="name">
    <svg class="signature" viewBox="0 0 640 261" role="img" aria-label="Nihesh">
      <path fill="currentColor" fill-rule="evenodd" pathLength="1" d={signaturePath} />
    </svg>
    <span class="surname">Rachakonda</span>
  </h1>

  <p class="role">{site.jobTitle}</p>
  <p class="intro">{site.intro}</p>

  <p class="actions">
    <a class="btn" href={site.resume} target="_blank" rel="noopener">
      <Icon name="file" />
      Résumé
    </a>
    <span class="hint muted">or press <kbd>R</kbd></span>
  </p>
</section>
</div>

<script is:inline>
  // Scroll intro: "Nihesh" starts as a full-screen outline, then shrinks into
  // place and fills with ink as you scroll; the rest of the hero fades in.
  // Runs inline (before first paint). Skipped entirely under reduced motion.
  (function () {
    var root = document.documentElement;
    if (!root.classList.contains("anim-intro")) return;
    var stage = document.querySelector(".hero-stage");
    var hero = stage.querySelector(".hero");
    var sig = hero.querySelector(".signature");
    var base, D, top0, lastW = 0, queued = false;

    function clamp(v) { return v < 0 ? 0 : v > 1 ? 1 : v; }
    function smooth(a, b, v) { v = clamp((v - a) / (b - a)); return v * v * (3 - 2 * v); }

    function measure() {
      sig.style.transform = "none";
      stage.style.height = "";
      var h = hero.getBoundingClientRect(), r = sig.getBoundingClientRect();
      base = { x: r.left - h.left, y: r.top - h.top, w: r.width, h: r.height };
      D = Math.round(innerHeight * 0.9); // scroll distance the intro takes
      top0 = stage.offsetTop;
      stage.style.height = hero.offsetHeight + D + "px";
      lastW = innerWidth;
      update();
    }

    function update() {
      queued = false;
      var vw = innerWidth, vh = innerHeight, h = hero.getBoundingClientRect();
      var p = clamp(scrollY / (D + top0));
      var k = 1 - smooth(0, 0.85, p);
      var s0 = Math.min((vw * 0.86) / base.w, (vh * 0.6) / base.h);
      var dx = vw / 2 - h.left - (base.x + base.w / 2);
      var dy = vh / 2 - h.top - (base.y + base.h / 2);
      sig.style.transform =
        "translate(" + (dx * k).toFixed(1) + "px," + (dy * k).toFixed(1) + "px) scale(" + (1 + (s0 - 1) * k).toFixed(4) + ")";
      hero.style.setProperty("--fill", smooth(0.3, 0.8, p).toFixed(3));
      hero.style.setProperty("--rest", smooth(0.6, 1, p).toFixed(3));
    }

    function onScroll() { if (!queued) { queued = true; requestAnimationFrame(update); } }

    measure();
    addEventListener("scroll", onScroll, { passive: true });
    // Mobile URL bars fire resize while scrolling; only re-measure on real width changes.
    addEventListener("resize", function () { if (innerWidth !== lastW) measure(); else onScroll(); });
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(measure);
  })();
</script>

<style>
  /* First screen is the hero alone: fill the viewport below the header
     (5.5rem tall) so nothing from the next section peeks in on any device.
     svh = smallest viewport (mobile URL bar shown), so it never overflows. */
  .hero {
    min-height: calc(100svh - 5.5rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: 2rem 4.5rem;
  }
  .name {
    margin: 0;
    display: grid;
    justify-items: start;
    font-weight: 400;
  }
  .signature {
    display: block;
    width: clamp(15rem, 78vw, 34rem);
    height: auto;
    aspect-ratio: 640 / 261;
    color: var(--ink);
    overflow: visible;
  }
  @media (min-width: 56rem) {
    .name {
      grid-template-columns: auto auto;
      justify-content: start;
      align-items: end;
      column-gap: 1.75rem;
    }
    .name .surname {
      margin: 0 0 0.9rem;
    }
  }
  .surname {
    display: block;
    margin-top: clamp(0.25rem, 1vw, 0.75rem);
    font-size: clamp(1.9rem, 6.2vw, 3.6rem);
    line-height: 1;
    letter-spacing: -0.02em;
    font-weight: 380;
    font-variant-numeric: lining-nums;
  }
  .role {
    margin: clamp(2rem, 5vw, 3rem) 0 0;
    font-size: 1.0625rem;
    color: var(--mute);
  }
  .intro {
    margin: 0.4rem 0 0;
    max-width: 34ch;
    font-size: clamp(1.35rem, 2.6vw, 1.75rem);
    line-height: 1.3;
    letter-spacing: -0.01em;
    font-weight: 360;
    text-wrap: pretty;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin: 1.75rem 0 0;
  }
  /* Short, wide screens (landscape phones): name left, text right, so the
     hero fits in the ~300px left under the header. */
  @media (max-height: 32rem) and (min-width: 40rem) {
    .hero {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: clamp(1.5rem, 4vw, 3rem);
      align-content: center;
      align-items: center;
      padding-block: 0 1rem;
    }
    .name {
      grid-row: 1 / span 3;
      grid-template-columns: auto;
    }
    .name .surname {
      margin: 0.25rem 0 0;
    }
    .signature {
      width: min(16rem, 34vw);
    }
    .surname {
      font-size: clamp(1.5rem, 7svh, 2rem);
    }
    .role,
    .intro,
    .actions {
      grid-column: 2;
    }
    .role {
      margin-top: 0;
      align-self: end;
    }
    .intro {
      font-size: 1.05rem;
      max-width: 36ch;
    }
    .actions {
      margin-top: 0.75rem;
      align-self: start;
    }
  }
  /* ---------- scroll intro (html.anim-intro is set in <head>) ---------- */
  :global(html.anim-intro) .hero {
    position: sticky;
    top: 0;
  }
  :global(html.anim-intro) .signature {
    position: relative;
    z-index: 1;
    transform-origin: 50% 50%;
    will-change: transform;
  }
  :global(html.anim-intro) .signature path {
    fill-opacity: var(--fill, 0);
    stroke: currentColor;
    stroke-width: 1.1;
    vector-effect: non-scaling-stroke;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    animation: sig-draw 2s cubic-bezier(0.5, 0, 0.3, 1) 0.1s both;
  }
  :global(html.anim-intro) .surname,
  :global(html.anim-intro) .role,
  :global(html.anim-intro) .intro,
  :global(html.anim-intro) .actions {
    opacity: var(--rest, 0);
    translate: 0 calc((1 - var(--rest, 0)) * 0.9rem);
  }
  @keyframes sig-draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.1rem 0.65rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    text-decoration: none;
    font-size: 1rem;
    line-height: 1;
  }
  .btn:hover {
    opacity: 0.88;
  }
  .hint {
    font-size: 0.95rem;
  }
  @media (hover: none) {
    .hint {
      display: none;
    }
  }
</style>
