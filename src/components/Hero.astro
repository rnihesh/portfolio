<style>
  /* First screen is the hero alone: fill the viewport below the header
     (5.5rem tall) so nothing from the next section peeks in on any device.
     svh = smallest viewport (mobile URL bar shown), so it never overflows. */
  .hero {
    min-height: calc(100svh - 5.5rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: 2rem 4.5rem;
  }
  .name {
    margin: 0;
    display: grid;
    justify-items: start;
    font-weight: 400;
  }
  .signature {
    display: block;
    width: clamp(15rem, 78vw, 34rem);
    height: auto;
    aspect-ratio: 640 / 261;
    color: var(--ink);
    overflow: visible;
  }
  /* Signature "writes" itself left to right once, on load. */
  @media (prefers-reduced-motion: no-preference) {
    .js .signature {
      -webkit-mask-image: linear-gradient(90deg, #000 40%, transparent 60%);
      mask-image: linear-gradient(90deg, #000 40%, transparent 60%);
      -webkit-mask-size: 250% 100%;
      mask-size: 250% 100%;
      -webkit-mask-repeat: no-repeat;
      mask-repeat: no-repeat;
      animation: write 1.6s cubic-bezier(0.45, 0.05, 0.35, 1) 0.15s both;
    }
  }
  @keyframes write {
    from {
      -webkit-mask-position: 100% 0;
      mask-position: 100% 0;
    }
    to {
      -webkit-mask-position: 0 0;
      mask-position: 0 0;
    }
  }
  @media (min-width: 56rem) {
    .name {
      grid-template-columns: auto auto;
      justify-content: start;
      align-items: end;
      column-gap: 1.75rem;
    }
    .name .surname {
      margin: 0 0 0.9rem;
    }
  }
  .surname {
    display: block;
    margin-top: clamp(0.25rem, 1vw, 0.75rem);
    font-size: clamp(1.9rem, 6.2vw, 3.6rem);
    line-height: 1;
    letter-spacing: -0.02em;
    font-weight: 380;
    font-variant-numeric: lining-nums;
  }
  .role {
    margin: clamp(2rem, 5vw, 3rem) 0 0;
    font-size: 1.0625rem;
    color: var(--mute);
  }
  .intro {
    margin: 0.4rem 0 0;
    max-width: 34ch;
    font-size: clamp(1.35rem, 2.6vw, 1.75rem);
    line-height: 1.3;
    letter-spacing: -0.01em;
    font-weight: 360;
    text-wrap: pretty;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin: 1.75rem 0 0;
  }
  /* Short, wide screens (landscape phones): name left, text right, so the
     hero fits in the ~300px left under the header. */
  @media (max-height: 32rem) and (min-width: 40rem) {
    .hero {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: clamp(1.5rem, 4vw, 3rem);
      align-content: center;
      align-items: center;
      padding-block: 0 1rem;
    }
    .name {
      grid-row: 1 / span 3;
      grid-template-columns: auto;
    }
    .name .surname {
      margin: 0.25rem 0 0;
    }
    .signature {
      width: min(16rem, 34vw);
    }
    .surname {
      font-size: clamp(1.5rem, 7svh, 2rem);
    }
    .role,
    .intro,
    .actions {
      grid-column: 2;
    }
    .role {
      margin-top: 0;
      align-self: end;
    }
    .intro {
      font-size: 1.05rem;
      max-width: 36ch;
    }
    .actions {
      margin-top: 0.75rem;
      align-self: start;
    }
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.1rem 0.65rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    text-decoration: none;
    font-size: 1rem;
    line-height: 1;
  }
  .btn:hover {
    opacity: 0.88;
  }
  .hint {
    font-size: 0.95rem;
  }
  @media (hover: none) {
    .hint {
      display: none;
    }
  }
</style>
